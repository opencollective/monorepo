# Developer configuration for isolated Orca workspace VMs and golden-image builds.
# Shared WORKSPACE_* settings describe the development environment; prefixed
# backend settings configure the VM provider. Local scripts and devcontainers
# keep their existing behavior.
#
# Copy this file to the Git-ignored .env.workspace.local and edit your copy.
# scripts/workspace/workspace.sh and build-golden-image.sh read that file by
# default; pass --config /absolute/path/to/file to use another configuration.
# Environment variables override file values. Values are literal data, not shell
# expressions: no variable expansion, command substitution, or inline comments.
# Use absolute paths for host files; do not put credentials in repository URLs.
# Setup, refresh, and maintenance instructions: docs/workspace-environments.md.

# -----------------------------------------------------------------------------
# Backend and repository checkouts
# -----------------------------------------------------------------------------

# VM provider adapter. Only incus is supported at the moment; other backends
# require an implementation in scripts/workspace/backends/ before selection.
WORKSPACE_BACKEND=incus

# Public HTTPS URL of the umbrella monorepo, cloned inside the golden-image
# builder and refreshed when creating workspaces. Its .gitmodules and init script
# supply the selected service repositories. Configurable so developers can use a
# compatible public fork or mirror without editing provisioning scripts.
# This is a remote Git source, never a host checkout path or filesystem mount.
WORKSPACE_REPO_URL=https://github.com/opencollective/monorepo.git

# Baseline branch fetched during image builds and workspace refreshes. Orca's
# requested branch and pinned commit are applied afterwards to its project root.
WORKSPACE_REPO_BRANCH=main

# Comma-separated projects to clone and cache dependencies for. The default
# includes all supported public projects; the private security repo is excluded.
WORKSPACE_PROJECTS=opencollective,api,frontend,documentation,images,pdf,rest,taxes,rss

# Application services started by PM2. Also supports images,pdf,rest; each running
# service must be included in WORKSPACE_PROJECTS. Leave empty to start none.
WORKSPACE_SERVICES=api,frontend

# Docker Compose dependencies: db=PostgreSQL, mail=Mailpit, uploads=RustFS.
# Add search for OpenSearch. These use the API project's Compose files, so select
# api above. Running the API requires db. Leave empty for no dependency services.
WORKSPACE_DEPENDENCY_SERVICES=db,mail,uploads

# -----------------------------------------------------------------------------
# Agent CLIs and development tooling baked into the golden image
# -----------------------------------------------------------------------------

# Comma-separated agent CLIs to install; supports codex,opencode or an empty list.
WORKSPACE_AGENT_TOOLS=codex,opencode

# Versions resolve during each image build; the manifest records exact installed
# versions. Use explicit versions instead of latest when you need repeatability.
WORKSPACE_CODEX_VERSION=latest
WORKSPACE_OPENCODE_VERSION=latest

# Numeric Node versions/series, comma-separated (for example 24,22). The first is
# the guest default; repository .nvmrc files select their own numeric versions.
WORKSPACE_NODE_VERSIONS=24

# npm version/series installed with Node, and PM2 version for managing services.
WORKSPACE_NPM_VERSION=11
WORKSPACE_PM2_VERSION=latest

# -----------------------------------------------------------------------------
# Guest OS, user, and checkout location
# -----------------------------------------------------------------------------

# Clean-build OS image. Provisioning currently supports only Ubuntu 24.04 cloud.
# Normal refreshes clone the active golden image; --rebuild uses this OS image.
WORKSPACE_GUEST_OS=ubuntu/24.04/cloud

# Non-root SSH/development account, with Docker access and sudo inside its VM.
WORKSPACE_GUEST_USER=developer

# Absolute path inside each guest for its independent monorepo checkout.
# This does not share or mount a directory from the host.
WORKSPACE_GUEST_ROOT=/workspace

# -----------------------------------------------------------------------------
# Workspace resources and aggregate quotas
# -----------------------------------------------------------------------------

# Maximum workspace VMs, all permitted to run. Setup reserves one additional
# builder/validation VM and derives project CPU/RAM ceilings from these values.
# Defaults: 11 VMs, 44 vCPUs, 176 GiB guest RAM (plus host memory overhead).
WORKSPACE_MAX_COUNT=10

# Per-VM vCPUs and RAM, applied through the backend's resource profile.
WORKSPACE_CPUS=4
WORKSPACE_MEMORY_GIB=16

# Per-VM logical root disk capacity, including checkouts, caches, and Docker data.
WORKSPACE_DISK_GIB=100

# Per-VM disk capacity reserved for saved memory during stateful suspend.
# Must be at least WORKSPACE_MEMORY_GIB + 2 GiB.
WORKSPACE_STATE_DISK_GIB=20

# Aggregate logical disk quota for the project, including VM disks and images.
# Separate from the sparse storage pool's physical capacity ceiling below.
WORKSPACE_DISK_BUDGET_GIB=2048

# -----------------------------------------------------------------------------
# Network isolation and SSH access
# -----------------------------------------------------------------------------

# Per-VM NIC bandwidth limit in Mbit/s.
WORKSPACE_BANDWIDTH_MBIT=100

# Only internet-only is implemented: allow public internet and bridge DHCP/DNS,
# block guest-initiated host/LAN/sibling access, and disable guest IPv6.
# Application/dependency ports use guest loopback and SSH forwarding for access.
WORKSPACE_NETWORK_POLICY=internet-only

# Guest SSH listening port; host access uses a unique key and pinned host key
# per workspace. Host SSH-agent forwarding is disabled.
WORKSPACE_SSH_PORT=22

# -----------------------------------------------------------------------------
# Golden-image naming and operation timeouts
# -----------------------------------------------------------------------------

# Active private golden-image alias. Builds publish versioned candidates and
# retain the preceding active image under <name>-previous for rollback.
WORKSPACE_IMAGE_NAME=oc-development

# Readiness and normal guest-command timeout, in seconds.
WORKSPACE_TIMEOUT_SECONDS=900

# Golden-image provisioning command timeout, in seconds (two hours by default).
WORKSPACE_BUILD_TIMEOUT_SECONDS=7200

# -----------------------------------------------------------------------------
# Host storage admission checks and trusted lifecycle installation
# -----------------------------------------------------------------------------

# Minimum free space on the pool's host filesystem before new allocations.
WORKSPACE_MIN_HOST_FREE_GIB=20

# Refuse new allocations at this thin-pool data OR metadata usage percentage.
# These are admission checks; they do not continuously monitor running guests.
WORKSPACE_STORAGE_MAX_PERCENT=85

# Host directory for ownership records, locks, workspace SSH keys, and aliases.
# Empty defaults to ~/.local/state/oc-workspace; otherwise use an absolute path.
WORKSPACE_STATE_DIR=

# Trusted host scripts/config copied by the install command, outside agent
# checkouts. Empty defaults to ~/.local/lib/oc-workspace. Reinstall after changing
# scripts/config so registered Orca recipes use the updated installed copy.
WORKSPACE_INSTALL_DIR=

# -----------------------------------------------------------------------------
# Optional credentials injected only into workspace VMs
# -----------------------------------------------------------------------------

# Dedicated development credential files; never copied into golden images.
# JSON maps absolute host file paths to paths relative to the guest user's home.
# Files must be owned by the host user, non-symlink, and private (for example 600).
# Supported destinations: .codex/auth.json, .local/share/opencode/auth.json,
# .config/gh/hosts.yml. An empty object injects no credentials. Example:
# WORKSPACE_CREDENTIAL_FILES='{"/home/me/dev-auth/codex.json":".codex/auth.json"}'
WORKSPACE_CREDENTIAL_FILES={}

# -----------------------------------------------------------------------------
# Incus-specific host resources
# -----------------------------------------------------------------------------

# Dedicated restricted project containing Orca's VMs, private images, and profiles.
INCUS_PROJECT=orca

# Owned LVM thin storage pool. Setup creates an Incus-managed sparse backing file;
# it never accepts a physical host disk, partition, or existing host volume group.
INCUS_STORAGE_POOL=orca-vms

# Initial sparse backing-file capacity ceiling, in GiB. Actual allocated host
# blocks grow as guests write. Use grow-pool to increase an existing pool; changing
# this value does not resize it. Never truncate the backing file to shrink it.
INCUS_POOL_SIZE_GIB=512

# Dedicated NAT bridge name, used by workspace NICs and persistent host firewall.
INCUS_NETWORK=orcabr0

# Bridge gateway/subnet, currently requiring an IPv4 .1/24 address. Change before
# setup if it overlaps your LAN, VPN, Docker, or other Incus networks.
INCUS_SUBNET=10.231.0.1/24

# Project-local profile holding CPU/RAM, root/state disks, and isolated NIC limits.
# Keeps resource settings separate from the golden image's development tooling.
INCUS_PROFILE=oc-workspace
