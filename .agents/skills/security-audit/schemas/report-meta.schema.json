{
  "$comment": "Structured ingest facts for reports/<year>-<month>/<report-folder-id>/meta.json (e.g. gm_<gmailId>). No body text, no raw.eml.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "messageId",
    "date",
    "from",
    "subject",
    "to",
    "cc",
    "inReplyTo",
    "attachments",
    "status",
    "sentAt",
    "path"
  ],
  "properties": {
    "messageId": {
      "type": "string",
      "minLength": 1
    },
    "date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}(T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?(Z|[+-][0-9]{2}:[0-9]{2}))?$"
    },
    "from": {
      "type": "string",
      "minLength": 1
    },
    "subject": {
      "type": "string",
      "minLength": 1
    },
    "to": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "cc": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "inReplyTo": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "attachments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "sha256", "size"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{64}$"
          },
          "size": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "gmailId": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "threadId": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "githubIssue": {
      "$comment": "GitHub issue on opencollective/opencollective-security linked to this report. Written by the dashboard.",
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["number", "url", "title", "state"],
          "properties": {
            "number": {
              "type": "integer",
              "minimum": 1
            },
            "url": {
              "type": "string",
              "pattern": "^https?://"
            },
            "title": {
              "type": "string"
            },
            "state": {
              "type": "string",
              "enum": ["open", "closed"]
            }
          }
        }
      ]
    },
    "status": {
      "type": "string",
      "enum": ["TO_REVIEW", "REVIEWING", "REVIEWED", "CLOSED"]
    },
    "sentAt": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}(T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?(Z|[+-][0-9]{2}:[0-9]{2}))?$"
        },
        {
          "type": "null"
        }
      ]
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^reports/[0-9]{4}-[0-9]{2}/[A-Za-z0-9._-]+/$"
    }
  }
}
